# Documentation only: Spring Boot does not automatically load .env files.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smartclass_db
DB_USERNAME=root
DB_PASSWORD=
APP_SEED_ENABLED=true
SEED_ADMIN_PASSWORD=
SEED_TEACHER_PASSWORD=
SEED_STUDENT_PASSWORD=
# Local defaults apply only with SPRING_PROFILES_ACTIVE=local.
SPRING_PROFILES_ACTIVE=local

# Base64-encoded cryptographically random key, at least 32 decoded bytes.
JWT_SECRET=
JWT_EXPIRATION=7200000
CORS_ALLOWED_ORIGINS=http://localhost:5173

NODERED_BASE_URL=http://localhost:1880
NODERED_STATE_PATH=/smarthome/api/state
NODERED_COMMAND_PATH=/smarthome/api/command
NODERED_CONNECT_TIMEOUT=3000
NODERED_READ_TIMEOUT=15000
NODERED_ACTUATOR_DEVICE_ID=node2_actuator
NODERED_SENSOR_DEVICE_ID=node1_sensor
NODERED_ACK_TIMEOUT=8000
NODERED_ACK_POLL_INTERVAL=400
COLLECTOR_ENABLED=true
COLLECTOR_POLL_INTERVAL_MS=2000
COLLECTOR_TELEMETRY_INTERVAL_MS=15000
